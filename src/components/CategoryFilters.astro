---
import { CATEGORIES } from '../content.config';
import { categorySlug } from '../lib/urls';

interface Props {
  /** Categoría activa; sin valor = "Todos". */
  current?: string;
}
const { current } = Astro.props;
---
<nav class="cat-filters" aria-label="Filtrar por categoría">
  <a href="/articulos/" aria-current={current ? undefined : 'page'}>Todos</a>
  {CATEGORIES.map((cat) => (
    <a
      href={`/articulos/${categorySlug(cat)}/`}
      aria-current={cat === current ? 'page' : undefined}
    >{cat}</a>
  ))}
</nav>

<style>
  .cat-filters {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: 1.2rem;
  }
  .cat-filters a {
    display: inline-block;
    padding: .3rem .85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: .85rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    background: var(--surface);
    transition: border-color .15s, color .15s;
  }
  .cat-filters a:hover,
  .cat-filters a[aria-current="page"] {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--bg);
  }
</style>

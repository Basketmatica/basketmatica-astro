---
import Icon from './Icon.astro';
import { SITE_TITLE, CONTACT_EMAIL, SOCIAL, NEWSLETTER_URL } from '../consts';
const year = new Date().getFullYear();

const explore = [
  { href: '/articulos/', label: 'Artículos' },
  { href: '/herramientas/', label: 'Herramientas' },
  { href: '/glosario/', label: 'Glosario' },
  { href: '/archivo-basketmatica/', label: 'Archivo de hilos' },
  { href: '/datos/', label: 'Datos y código' },
];
const project = [
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/servicios/', label: 'Servicios' },
  { href: '/buscar/', label: 'Buscar' },
  { href: NEWSLETTER_URL, label: 'Newsletter', external: true },
];
---
<footer class="site-footer">
  <div class="container container-wide">
    <div class="footer-grid">
      <div class="footer-about">
        <p class="footer-brand">{SITE_TITLE}</p>
        <p>Análisis de datos aplicado al baloncesto: artículos, herramientas y métricas explicadas en español.</p>
      </div>

      <nav aria-label="Explorar">
        <p class="footer-title">Explorar</p>
        <ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>

      <nav aria-label="Proyecto">
        <p class="footer-title">Proyecto</p>
        <ul>
          {project.map((l) => (
            <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Redes y contacto">
        <p class="footer-title">Sígueme</p>
        <ul>
          <li><a href={SOCIAL.x} target="_blank" rel="noopener">X</a></li>
          <li><a href={SOCIAL.threads} target="_blank" rel="noopener">Threads</a></li>
          <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/rss.xml"><Icon name="rss" size={15} /> RSS</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>Contacto</a></li>
        </ul>
      </nav>
    </div>
    <p class="footer-legal">© {year} {SITE_TITLE}. Los datos proceden de fuentes públicas citadas en cada análisis.</p>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-brand { font-family: var(--font-display); font-weight: 700; color: var(--brand); font-size: 1.1rem; margin: 0 0 .4rem; }
  .footer-about p { margin: 0; max-width: 30ch; line-height: 1.55; }
  .footer-title {
    font-family: var(--font-display); font-size: .72rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: var(--ink); margin: 0 0 .7rem;
  }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
  a { color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--brand); text-decoration: underline; }
  .footer-legal { margin: 2rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--line); font-size: .82rem; }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-about { grid-column: 1 / -1; }
  }
</style>

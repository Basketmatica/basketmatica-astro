---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MetricOfWeek from '../components/MetricOfWeek.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import HexDivider from '../components/HexDivider.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import reportImg from '../assets/blog/generador-reportes-acb/02-informe-campazzo.jpg';
import { metricasSemana } from '../data/metricas-semana';
import { getArticles } from '../lib/articles';
import { getGlossaryTerms, findTerm } from '../lib/glosario';
import { threads } from '../data/hilos';

const posts = (await getArticles()).slice(0, 3);
const terms = await getGlossaryTerms();

// Métrica de la semana: rota una por semana según la fecha del build.
// ANCHOR es el lunes en el que el índice 0 (Free Throw Rate) está activo.
const ANCHOR = Date.UTC(2026, 5, 8);
const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const semanas = Math.floor((Date.now() - ANCHOR) / WEEK_MS);
const indiceMetrica = ((semanas % metricasSemana.length) + metricasSemana.length) % metricasSemana.length;
const metrica = metricasSemana[indiceMetrica];
// La métrica de la semana debe tener ficha en el glosario: si no, el build avisa.
const ficha = await findTerm(metrica.name, metrica.acronym);
if (!ficha) throw new Error(`La métrica «${metrica.name}» no existe en el glosario (src/content/pages/glosario.md)`);

const explore: { href: string; icon: IconName; title: string; text: string }[] = [
  { href: '/glosario/', icon: 'book', title: 'Glosario', text: `${terms.length} métricas explicadas en español, con su fórmula y un hilo donde se aplican.` },
  { href: '/archivo-basketmatica/', icon: 'archive', title: 'Archivo de hilos', text: `${threads.length} hilos de X filtrables por tema, de los fundamentos a los casos prácticos.` },
  { href: '/datos/', icon: 'database', title: 'Datos y código', text: 'Repositorios abiertos y datasets de cada análisis, para reproducirlo tú mismo.' },
];

const heroDesc = 'Estadística avanzada, modelos predictivos y análisis de IA aplicados al baloncesto que te gusta. Código y números detrás del juego.';
---
<BaseLayout wide description={heroDesc}>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero-hex" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hero-hex-p" width="42" height="48" patternUnits="userSpaceOnUse" patternTransform="rotate(8)">
            <path d="M21 2.5 L40 13 L40 35 L21 45.5 L2 35 L2 13 Z" fill="none" stroke="currentColor" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#hero-hex-p)"/>
      </svg>
    </div>
    <div class="hero-content">
      <p class="eyebrow">Análisis de datos · Baloncesto</p>
      <h1 class="hero-title">El dato detrás<br>del juego</h1>
      <p class="hero-sub">{heroDesc}</p>
      <div class="hero-actions">
        <a href="/articulos/" class="btn-primary">Explorar artículos</a>
        <a href="/herramientas/" class="btn-outline">Herramientas gratuitas</a>
      </div>
    </div>
  </section>

  <!-- ===== Qué publico ===== -->
  <section class="cadence" aria-label="Qué publico">
    <div class="cadence-item">
      <span class="cadence-freq">Hilos en X</span>
      <span class="cadence-what">La jornada y las métricas, en datos</span>
    </div>
    <span class="cadence-sep" aria-hidden="true">·</span>
    <div class="cadence-item">
      <span class="cadence-freq">Artículos</span>
      <span class="cadence-what">Análisis a fondo, con código abierto</span>
    </div>
    <span class="cadence-sep" aria-hidden="true">·</span>
    <div class="cadence-item">
      <span class="cadence-freq">Herramientas</span>
      <span class="cadence-what">Gratuitas y que puedes usar hoy</span>
    </div>
  </section>

  <HexDivider />

  <!-- ===== Herramienta destacada ===== -->
  <section class="featured-tool">
    <p class="eyebrow">Herramienta destacada</p>
    <div class="tool-spotlight">
      <div class="tool-spotlight-text">
        <h2 class="tool-title">Generador de Reportes ACB</h2>
        <p>
          Introduce el nombre de cualquier jugador de la Liga Endesa y obtén un scouting report en PDF
          con estadísticas avanzadas, análisis FODA y comparativa con jugadores similares —
          en menos de un minuto.
        </p>
        <a href="/herramientas/generador-reportes-acb/" class="btn-primary">Generar reporte gratis <Icon name="arrow" size={18} /></a>
      </div>
      <a class="tool-spotlight-shot" href="/herramientas/generador-reportes-acb/" tabindex="-1" aria-hidden="true">
        <Image src={reportImg} alt="" widths={[360, 560]} sizes="(max-width: 580px) 100vw, 280px" />
      </a>
    </div>
  </section>

  <HexDivider />

  <!-- ===== Últimos artículos ===== -->
  <section class="latest-articles">
    <div class="section-header">
      <p class="eyebrow" style="margin:0">Últimas publicaciones</p>
      <a href="/articulos/" class="section-more">Ver todos →</a>
    </div>
    <div class="articles-grid">
      {posts.map((post) => <ArticleCard post={post} />)}
    </div>
  </section>

  <!-- ===== Métrica de la semana ===== -->
  <MetricOfWeek
    name={metrica.name}
    acronym={metrica.acronym}
    definition={metrica.definition}
    href={`/glosario/#${ficha.slug}`}
  />

  <!-- ===== Explora ===== -->
  <section class="explore" aria-label="Explora">
    <p class="eyebrow">Explora</p>
    <div class="explore-grid">
      {explore.map((e) => (
        <a class="explore-card" href={e.href}>
          <span class="explore-icon"><Icon name={e.icon} size={26} /></span>
          <h2 class="explore-title">{e.title}</h2>
          <p>{e.text}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== Newsletter ===== -->
  <NewsletterCTA />

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 3.5rem;
    margin-bottom: 2rem;
  }

  .hero-hex {
    color: var(--brand);
    position: absolute;
    inset: 0;
    opacity: .07;
    pointer-events: none;
  }

  .hero-content { position: relative; max-width: 640px; }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--ink-soft);
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 520px;
  }

  .hero-actions { display: flex; gap: .8rem; flex-wrap: wrap; }

  /* ---- Cadence strip ---- */
  .cadence {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .cadence-item {
    display: flex;
    flex-direction: column;
    gap: .15rem;
    flex: 1;
    min-width: 130px;
  }

  .cadence-freq {
    font-family: var(--font-display);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--accent-600);
  }

  .cadence-what { font-size: .97rem; font-weight: 500; color: var(--ink); }
  .cadence-sep { color: var(--line); font-size: 1.5rem; flex-shrink: 0; }

  /* ---- Featured tool ---- */
  .featured-tool { margin-bottom: 2rem; }

  .tool-spotlight {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow);
  }

  .tool-spotlight-text { flex: 1; }
  .tool-title { margin: 0 0 .7rem; font-size: 1.45rem; }
  .tool-spotlight-text p { color: var(--ink-soft); margin: 0 0 1.3rem; font-size: 1rem; line-height: 1.6; }
  .tool-spotlight-shot {
    flex-shrink: 0; width: 280px; aspect-ratio: 4 / 3; overflow: hidden;
    border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow);
  }
  .tool-spotlight-shot :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: left top;
    transition: transform .3s;
  }
  .tool-spotlight-shot:hover :global(img) { transform: scale(1.03); }

  /* ---- Explora ---- */
  .explore { margin-bottom: 2rem; }
  .explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .explore-card {
    display: flex; flex-direction: column; gap: .5rem; padding: 1.4rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; box-shadow: var(--shadow); transition: border-color .2s, box-shadow .2s;
  }
  .explore-card:hover { border-color: var(--brand); box-shadow: var(--shadow-hover); }
  .explore-icon { color: var(--accent-600); line-height: 0; }
  .explore-title { margin: 0; font-size: 1.15rem; }
  .explore-card p { margin: 0; color: var(--ink-soft); font-size: .93rem; line-height: 1.55; }

  /* ---- Latest articles ---- */
  .latest-articles { margin-bottom: 0; }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.3rem;
  }

  .section-more {
    font-family: var(--font-display);
    font-size: .9rem;
    font-weight: 600;
    color: var(--accent-600);
    text-decoration: none;
    flex-shrink: 0;
  }
  .section-more:hover { color: var(--accent); }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 820px) {
    .explore-grid { grid-template-columns: 1fr; }
    .tool-spotlight { flex-wrap: wrap; }
    .articles-grid { grid-template-columns: 1fr 1fr; }
    .articles-grid > :last-child { display: none; }
  }

  @media (max-width: 580px) {
    .hero { padding: 2.5rem 0 2rem; }
    .articles-grid { grid-template-columns: 1fr; }
    .articles-grid > :last-child { display: revert; }
    .tool-spotlight { flex-direction: column; gap: 1rem; }
    .tool-spotlight-shot { width: 100%; }
    .explore-grid { grid-template-columns: 1fr; }
    .cadence-sep { display: none; }
    .cadence { gap: .8rem; padding: 1.2rem 1.25rem; }
  }
</style>

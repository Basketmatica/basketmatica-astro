---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const page = await getEntry('pages', 'sobre-mi');
if (!page) throw new Error('Falta src/content/pages/sobre-mi.md');
const { Content } = await render(page);
const { title, description, heroImage, heroAlt } = page.data;
// El retrato es vertical: no se pasa como imagen social (1200×630 lo recortaría); queda el logo por defecto.
---
<BaseLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    {heroImage && (
      <Image class="portrait-img" src={heroImage} alt={heroAlt || title} widths={[300, 600]} sizes="(max-width: 340px) 100vw, 300px" loading="eager" />
    )}
    <div class="prose"><Content /></div>
    <SocialLinks />
  </article>
</BaseLayout>

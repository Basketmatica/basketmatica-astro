---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import { categorySlug, isPublished } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('articulos', isPublished);
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { categoria: categorySlug(category) },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
---
<BaseLayout
  wide
  title={category}
  description={`Entradas de la categoría ${category} en Basketmática.`}
>
  <section class="articles-header">
    <p class="post-meta"><a href="/articulos/">Artículos</a> / {category}</p>
    <h1>{category}</h1>
    <p class="intro">{posts.length} {posts.length === 1 ? 'entrada' : 'entradas'}.</p>
    <CategoryFilters current={category} />
  </section>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>

<style>
  .articles-header { padding-block: 2rem 1rem; }
</style>

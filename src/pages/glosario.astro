---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import 'katex/dist/katex.min.css';

const entry = await getEntry('articulos', 'glosario-de-basketball-analytics');
if (!entry) throw new Error('Entrada del glosario no encontrada');

const { Content, headings } = await render(entry);
// Índice generado a partir de los encabezados de métrica (h4): no puede desincronizarse.
const toc = headings.filter((h) => h.depth === 4);
const { title, description, heroImage, heroAlt } = entry.data;
---
<BaseLayout title={title} description={description} image={heroImage?.src}>
  <article class="glosario">
    <p class="post-meta"><a href="/articulos/">Artículos</a></p>

    {heroImage && (
      <Image
        class="hero-img"
        src={heroImage}
        alt={heroAlt || title}
        widths={[480, 760, 1080]}
        sizes="(max-width: 760px) 100vw, 760px"
      />
    )}

    <h1>{title}</h1>

    <details class="toc">
      <summary>ÍNDICE DEL GLOSARIO</summary>
      <ol>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .glosario { max-width: 760px; margin-inline: auto; }
  .glosario h1 { margin-top: 1.2rem; }

  /* Nombre de cada métrica: más grande y separado para diferenciarlo bien de
     definición/fórmula/etc. Se usa :global porque el contenido viene de <Content />. */
  .glosario :global(.prose h4) {
    font-size: 1.45rem;
    margin-top: 2.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .toc {
    margin: 1.2rem 0;
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: .8rem 1rem; background: var(--surface);
  }
  .toc summary { cursor: pointer; font-weight: 600; font-family: var(--font-display); }
  .toc[open] summary { margin-bottom: .6rem; }
  .toc ol { columns: 2 260px; column-gap: 2rem; padding-left: 1.4rem; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { herramientas, toolHref } from '../../data/herramientas';
---
<BaseLayout
  title="Herramientas"
  description="Herramientas de análisis de baloncesto desarrolladas en Basketmática: generadores de reportes, modelos y más."
>
  <section class="tools-header">
    <h1>Herramientas</h1>
    <p class="intro">
      Aplicaciones y utilidades de análisis construidas sobre datos reales de la NBA y la ACB.
      Cada trimestre se añade una nueva.
    </p>
  </section>

  <div class="tools-grid">
    {herramientas.map((h) => (
      <ToolCard title={h.title} description={h.description} status={h.status} href={toolHref(h)} icon={h.icon} />
    ))}
  </div>
</BaseLayout>

<style>
  .tools-header { padding-block: 2rem 1.5rem; }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
</style>

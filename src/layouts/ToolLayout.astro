---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  appUrl: string;
  heroImg?: ImageMetadata;
  heroAlt?: string;
  exampleReport?: { href: string; label: string };
}

const { title, description, appUrl, heroImg, heroAlt, exampleReport } = Astro.props;

// embed=true      → quita el chrome de Streamlit
// embed_options   → fuerza tema claro y oculta la barra de estado "Running…"
const EMBED_URL = `${appUrl}/?embed=true&embed_options=light_theme&embed_options=hide_loading_screen`;
---
<BaseLayout title={title} description={description} image={heroImg} imageAlt={heroAlt}>
  <article class="generador">
    <p class="post-meta"><a href="/herramientas/">Herramientas</a> / {title}</p>

    {heroImg && (
      <Image
        class="hero-img"
        src={heroImg}
        alt={heroAlt ?? title}
        widths={[480, 760, 1080]}
        sizes="(max-width: 760px) 100vw, 760px"
      />
    )}

    <h1>{title}</h1>

    <div class="prose">
      <slot />
    </div>

    <!-- Módulo embebido -->
    <section class="app-embed">
      <p class="embed-kicker">Genera tu reporte</p>
      <iframe
        src={EMBED_URL}
        title={title}
        loading="lazy"
        allow="clipboard-write"
      ></iframe>
      <p class="embed-fallback">
        ¿No carga el módulo? <a href={appUrl} target="_blank" rel="noopener">Ábrelo en una pestaña nueva</a>.
      </p>
    </section>

    {exampleReport && (
      <p class="example-report">
        ¿Quieres ver cómo queda antes de generarlo?
        <a href={exampleReport.href} download>{exampleReport.label}</a>.
      </p>
    )}

    <slot name="tips" />
    <slot name="note" />
  </article>
</BaseLayout>

<style>
  .generador { max-width: 760px; margin-inline: auto; }
  .generador h1 { margin-top: 1.2rem; }

  /* El módulo se presenta como una card de la marca: mismo borde, mismo radio
     y mismo shadow que el resto de bloques del sitio. El iframe va a sangre
     dentro de la card para que no se vea "una web dentro de otra". */
  .app-embed {
    max-width: 560px;
    margin: 2.5rem auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--surface);
  }
  .embed-kicker {
    margin: 0;
    padding: .7rem 1.1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .app-embed iframe {
    display: block;
    width: 100%;
    /* Alto fijo: un iframe cross-origin no puede auto-ajustarse.
       540px cubre formulario + estado + botón de descarga sin scroll interno. */
    height: 540px;
    border: none;
    color-scheme: light;   /* evita que el modo oscuro del SO invierta la app */
  }
  .embed-fallback {
    margin: 0;
    padding: .55rem 1rem;
    font-size: .82rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--line);
    text-align: center;
    background: var(--bg);
  }

  @media (max-width: 560px) {
    .app-embed iframe { height: 600px; }
  }

  .example-report { font-size: .93rem; text-align: center; margin-top: -.5rem; }

  :global(.generador .tips) {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: .91rem;
  }
  :global(.generador .tips-title) { font-family: var(--font-display); font-weight: 700; margin: 0 0 .5rem; color: var(--brand); font-size: .9rem; }
  :global(.generador .tips ul) { margin: 0; padding-left: 1.3rem; color: var(--ink-soft); line-height: 1.7; }

  :global(.generador .note) {
    font-size: .91rem;
    background: var(--surface);
    padding: 1rem;
    border-left: 4px solid var(--brand);
    border-radius: 6px;
    color: var(--ink-soft);
  }
</style>

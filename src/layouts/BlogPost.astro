---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { formatDate, categorySlug, postPath } from '../lib/urls';
import { SITE_URL } from '../consts';

interface Props {
  post: CollectionEntry<'articulos'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage, heroAlt } = post.data;
const articleUrl = SITE_URL + postPath(post);
const catUrl = `${SITE_URL}/articulos/${categorySlug(category)}/`;

// Relacionados: primero la misma categoría, luego el resto, del más reciente al más antiguo.
const all = (await getCollection('articulos', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = [
  ...all.filter((p) => p.data.category === category),
  ...all.filter((p) => p.data.category !== category),
].slice(0, 3);

const jsonLd = [
  {
    "@type": "BlogPosting",
    "@id": `${articleUrl}#article`,
    "headline": title,
    "description": description,
    "datePublished": pubDate.toISOString(),
    "dateModified": (updatedDate ?? pubDate).toISOString(),
    "url": articleUrl,
    "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
    "inLanguage": "es",
    "articleSection": category,
    "author": { "@id": `${SITE_URL}/#person` },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "isPartOf": { "@id": `${SITE_URL}/#website` },
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": category, "item": catUrl },
      { "@type": "ListItem", "position": 3, "name": title, "item": articleUrl },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  imageAlt={heroAlt || title}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  section={category}
  jsonLd={jsonLd}
>
  <article>
    <header>
      <p class="post-meta">
        <a class="badge" href={`/articulos/${categorySlug(category)}/`}>{category}</a>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </p>
      <h1>{title}</h1>
    </header>
    {heroImage && (
      <Image class="hero-img" src={heroImage} alt={heroAlt || title} widths={[480, 760, 1080]} sizes="(max-width: 760px) 100vw, 760px" loading="eager" fetchpriority="high" />
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
  {related.length > 0 && (
    <aside class="related" aria-labelledby="related-title">
      <h2 id="related-title">Sigue leyendo</h2>
      <ul class="post-list">
        {related.map((p) => <PostCard post={p} />)}
      </ul>
    </aside>
  )}
</BaseLayout>

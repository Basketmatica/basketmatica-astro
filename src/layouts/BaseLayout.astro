---
import '../styles/tokens.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/brand/logo_basketmatica-sin-fondo.png';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_URL, TWITTER_HANDLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  wide?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  wide = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Imagen social: JPEG 1200×630 (formato estándar de tarjeta), no el original de varios MB.
// Sin imagen propia se usa el logo sobre fondo blanco (el fuente es 350 px: no se amplía).
const ogSource = image ?? defaultOg;
const og = await getImage({
  src: ogSource,
  width: 1200,
  height: 630,
  fit: image ? 'cover' : 'contain',
  background: '#ffffff',
  format: 'jpeg',
  quality: 80,
});
const ogImage = new URL(og.src, Astro.site);
const ogAlt = imageAlt ?? (title ?? SITE_TITLE);

// Grafo global (mismos @id en todas las páginas para que Google enlace las entidades).
const graph = [
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    "url": SITE_URL,
    "name": SITE_TITLE,
    "description": SITE_DESCRIPTION,
    "inLanguage": "es",
    "publisher": { "@id": `${SITE_URL}/#organization` },
  },
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    "name": SITE_TITLE,
    "url": SITE_URL,
    "logo": { "@type": "ImageObject", "url": `${SITE_URL}/apple-touch-icon.png` },
    "founder": { "@id": `${SITE_URL}/#person` },
    "sameAs": [
      "https://x.com/basketmatica",
      "https://www.instagram.com/basketmatica/",
    ],
  },
  {
    "@type": "Person",
    "@id": `${SITE_URL}/#person`,
    "name": "Yago Riudavets",
    "url": `${SITE_URL}/sobre-mi/`,
    "sameAs": [
      "https://x.com/basketmatica",
      "https://www.instagram.com/basketmatica/",
      "https://www.linkedin.com/in/yago-riudavets-garc%C3%ADa-9b7b7b237/"
    ],
    "knowsAbout": ["Basketball Analytics", "Machine Learning", "Sports Data Science"],
    "worksFor": { "@id": `${SITE_URL}/#organization` },
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#583C14" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  </head>
  <body>
    <Nav />
    <main class={wide ? 'container container-wide' : 'container'}>
      <slot />
    </main>
    <Footer />
    <script>
      // Inyecta el form de Beehiiv en cada carga de página. astro:page-load dispara en la
      // carga inicial y tras cada navegación SPA (ClientRouter), y el listener vive en
      // `document`, que persiste entre swaps. Crear el <script> vía createElement garantiza
      // que se ejecute (los scripts insertados por el swap del DOM no se ejecutan solos).
      function loadBeehiiv() {
        const embed = document.querySelector('.beehiiv-embed');
        if (!embed || embed.querySelector('iframe, script')) return;
        const loader = document.createElement('script');
        loader.src = 'https://subscribe-forms.beehiiv.com/v3/loader.js';
        loader.async = true;
        loader.setAttribute('data-beehiiv-form', '5343eb1f-ae99-4ffd-86de-e70d2637e11f');
        embed.appendChild(loader);
        const attribution = document.createElement('script');
        attribution.src = 'https://subscribe-forms.beehiiv.com/attribution.js';
        attribution.async = true;
        embed.appendChild(attribution);
      }
      document.addEventListener('astro:page-load', loadBeehiiv);
    </script>
  </body>
</html>

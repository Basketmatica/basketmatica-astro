---
import '../styles/tokens.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/brand/og-default.jpg';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_URL, TWITTER_HANDLE, SOCIAL, GOATCOUNTER_CODE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  wide?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  wide = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Imagen social: JPEG 1200×630 (formato estándar de tarjeta), no el original de varios MB.
// Sin imagen propia se usa la tarjeta de marca (src/assets/brand/og-default.jpg).
const og = await getImage({
  src: image ?? defaultOg,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 80,
});
const ogImage = new URL(og.src, Astro.site);
const ogAlt = imageAlt ?? (title ?? SITE_TITLE);

// Grafo global (mismos @id en todas las páginas para que Google enlace las entidades).
const graph = [
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    "url": SITE_URL,
    "name": SITE_TITLE,
    "description": SITE_DESCRIPTION,
    "inLanguage": "es",
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": `${SITE_URL}/buscar/?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    "name": SITE_TITLE,
    "url": SITE_URL,
    "logo": { "@type": "ImageObject", "url": `${SITE_URL}/apple-touch-icon.png` },
    "founder": { "@id": `${SITE_URL}/#person` },
    "sameAs": [SOCIAL.x, SOCIAL.threads],
  },
  {
    "@type": "Person",
    "@id": `${SITE_URL}/#person`,
    "name": "Yago Riudavets",
    "url": `${SITE_URL}/sobre-mi/`,
    "sameAs": [SOCIAL.x, SOCIAL.threads, SOCIAL.linkedin],
    "knowsAbout": ["Basketball Analytics", "Machine Learning", "Sports Data Science"],
    "worksFor": { "@id": `${SITE_URL}/#organization` },
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4EFE5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16110B" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Tema antes del primer pintado (evita el parpadeo). La preferencia guardada manda;
      // sin ella se sigue la del sistema (CSS). ClientRouter reemplaza <html> en cada navegación,
      // así que se reaplica en astro:before-swap.
      (function () {
        var get = function () { try { return localStorage.getItem('theme'); } catch (e) { return null; } };
        var apply = function (root) { var t = get(); if (t === 'light' || t === 'dark') root.dataset.theme = t; };
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument.documentElement); });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Nav />
    <main id="main" class={wide ? 'container container-wide' : 'container'}>
      <slot />
    </main>
    <Footer />
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        async
        src="https://gc.zgo.at/count.js"
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
      ></script>
    )}
    <script>
      // Inyecta el form de Beehiiv en cada carga de página. astro:page-load dispara en la
      // carga inicial y tras cada navegación SPA (ClientRouter), y el listener vive en
      // `document`, que persiste entre swaps. Crear el <script> vía createElement garantiza
      // que se ejecute (los scripts insertados por el swap del DOM no se ejecutan solos).
      function loadBeehiiv() {
        const embed = document.querySelector('.beehiiv-embed');
        if (!embed || embed.querySelector('iframe, script')) return;
        const loader = document.createElement('script');
        loader.src = 'https://subscribe-forms.beehiiv.com/v3/loader.js';
        loader.async = true;
        loader.setAttribute('data-beehiiv-form', '5343eb1f-ae99-4ffd-86de-e70d2637e11f');
        embed.appendChild(loader);
        const attribution = document.createElement('script');
        attribution.src = 'https://subscribe-forms.beehiiv.com/attribution.js';
        attribution.async = true;
        embed.appendChild(attribution);
      }
      document.addEventListener('astro:page-load', loadBeehiiv);

      // Analítica (solo si hay GoatCounter configurado): el script de GoatCounter cuenta la carga
      // inicial; las navegaciones posteriores de ClientRouter se cuentan aquí.
      let firstLoad = true;
      document.addEventListener('astro:page-load', () => {
        if (firstLoad) { firstLoad = false; return; }
        const gc = (window as any).goatcounter;
        if (gc?.count) gc.count({ path: location.pathname + location.search });
      });
    </script>
  </body>
</html>
